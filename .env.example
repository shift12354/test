# Life Dashboard: kopier til .env (eller kjør `npm run setup`).
# ALDRI commit .env. Den er i .gitignore.

# --- Server ---
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
# Hemmelig tilgangsnøkkel, minst 32 tegn. `npm run setup` lager en tilfeldig.
DASHBOARD_TOKEN=
# Proxyer vi stoler på for X-Forwarded-For (rate limit per IP). Tom = "loopback" i produksjon.
# Sett til proxyens IP/CIDR hvis reverse proxy kjører på en annen maskin. Unngå "true".
TRUST_PROXY=
# Kommaseparert liste over tillatte web-origins (CORS)
CORS_ORIGINS=http://localhost:5173
# Tidssone for "i dag"-beregninger
TZ_NAME=Europe/Oslo
# Navnet ditt i hilsenen (valgfritt)
OWNER_NAME=

# --- Prioritering ---
# Kommaseparerte avsendere eller domener som alltid er viktige
VIP_SENDERS=
# Ditt brukernavn/handle i meldinger (for @-nevninger)
MY_HANDLES=

# --- Google (Gmail + Kalender), read-only ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Microsoft 365 / Outlook (Mail.Read, Calendars.Read) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=
MS_TENANT=common

# --- Slack (user token med search:read / channels:history) ---
SLACK_USER_TOKEN=

# --- Discord (bot-token + kanaler boten kan lese) ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# --- Telegram (bot-token fra @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- GitHub (fine-grained token, kun notifications:read) ---
GITHUB_TOKEN=

# --- Vær (MET Norway / yr, trenger ingen nøkkel) ---
WEATHER_LAT=
WEATHER_LON=
WEATHER_PLACE=
# MET krever kontaktinfo i User-Agent: https://api.met.no/doc/TermsOfService
WEATHER_CONTACT=

# --- Nyheter (RSS) ---
# Fjern # for å hente ekte nyheter (ellers vises demo-nyheter)
# NEWS_FEEDS=https://www.nrk.no/toppsaker.rss

# --- Push-varsler (Expo) ---
PUSH_ENABLED=false
